# Copy to .env and edit if needed
PORT=8000
# Match the container runtime user to your host user so backend/jobs is writable.
# Linux default user is commonly 1000:1000. If your host uses another UID/GID, set them here.
APP_UID=1000
APP_GID=1000
# If your deployment is behind a reverse proxy that sets X-Forwarded-* headers,
# keep this enabled (1). Otherwise set to 0.
TRUST_PROXY_HEADERS=1
